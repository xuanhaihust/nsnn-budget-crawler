# downloaded source files + catalogs — several GB, reproducible with ./nsnn
work/

# output/ is committed: the workbooks are tracked through Git LFS (see .gitattributes).
# Filenames carry the run date, so a re-run adds a new set rather than replacing the old
# one — prune old dates before committing if the LFS quota matters.

# data/nsnn.db.xz IS committed (33 MB, an ordinary git object - it does not touch the
# LFS quota). The 352 MB uncompressed database is not: `dashboard/db.py restore` unpacks
# it and rebuilds the indexes in ~13 s.
data/nsnn.db
data/*.packing

# the MCP server's folded search index: derived from nsnn.db, rebuilt in ~12s on first
# use, and larger than the warehouse it indexes is worth. Never committed.
data/nsnn-search.db

# python
.venv/
__pycache__/
*.pyc

# macos
.DS_Store
